					</div>
					
					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="en" dir="ltr" data-mw-parsoid-version="0.25.0.0-alpha1" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><div class="shortdescription nomobile noexcerpt noprint searchaux" style="display:none" about="#mwt1" typeof="mw:Transclusion" id="mwAg" data-mw='{"parts":[{"template":{"target":{"wt":"Short description","href":"./Template:Short_description"},"params":{"1":{"wt":"French rum and vanilla pâtisserie"}},"i":0}}]}'>French rum and vanilla pâtisserie</div><span class="mw-empty-elt" about="#mwt1"><link rel="mw:PageProp/Category" href="./Category:Articles_with_short_description"/><link rel="mw:PageProp/Category" href="./Category:Short_description_is_different_from_Wikidata"/></span>
<span class="mw-empty-elt" about="#mwt2" typeof="mw:Transclusion" id="mwAw" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox food\n","href":"./Template:Infobox_food"},"params":{"name":{"wt":"Canelé"},"image":{"wt":"File:Caneles stemilion.jpg"},"caption":{"wt":"Canelé"},"image_alt":{"wt":"Canelé"},"alternate_name":{"wt":"Cannelé"},"country":{"wt":"[[France]]"},"region":{"wt":"[[Bordeaux]]"},"creator":{"wt":"Couvent des Annonciades&lt;ref name=\"A. Michel\">{{cite book\n | title=Aquitaine: produits du terroir et recettes traditionnelles\n | publisher=A. Michel\n | year=1997\n | volume=13\n | language=fr\n | url=https://books.google.com/books?id=9PbgAAAAMAAJ\n | isbn=9782226087225}}&lt;/ref>"},"served":{"wt":"Warm"},"main_ingredient":{"wt":"[[flour]], [[milk]], [[egg yolk]], [[butter]], [[vanilla]], [[rum]], [[sugar|cane sugar]]"},"variations":{"wt":""},"calories":{"wt":""},"other":{"wt":""}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1358620234" typeof="mw:Extension/templatestyles" about="#mwt3" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'>@media(min-width:640px){.mw-parser-output .infobox{margin-left:1em;float:right;clear:right;width:22em}}.mw-parser-output .infobox-subbox{padding:0;border:none;margin:-3px;width:auto;min-width:100%;font-size:100%;clear:none;float:none;background-color:transparent;color:inherit}.mw-parser-output .infobox-3cols-child{margin:-3px}.mw-parser-output .infobox .navbar{font-size:100%}.mw-parser-output .infobox-hiddenrow,body.skin--responsive.skin--responsive .mw-parser-output .infobox .infobox-hiddenrow{display:none}@media screen{html.skin-theme-clientpref-night .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}}@media(min-width:640px){body.skin--responsive .mw-parser-output .infobox-table{display:table!important}body.skin--responsive .mw-parser-output .infobox-table>caption{display:table-caption!important}body.skin--responsive .mw-parser-output .infobox-table>tbody{display:table-row-group}body.skin--responsive .mw-parser-output .infobox-table th,body.skin--responsive .mw-parser-output .infobox-table td{padding-left:inherit;padding-right:inherit}}</style></span><table class="infobox hrecipe adr" about="#mwt2" id="mwBA"><caption class="infobox-title fn"><span>Canelé</span></caption><tbody><tr><td colspan="2" class="infobox-image"><span class="mw-default-size" typeof="mw:File/Frameless" data-mw='{"caption":"Canelé"}'><a href="https://en.wikipedia.org/wiki/File:Caneles_stemilion.jpg" class="mw-file-description" title="Canelé"><img resource="https://en.wikipedia.org/wiki/File:Caneles_stemilion.jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/a/aa/Caneles_stemilion.jpg/250px-Caneles_stemilion.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/a/aa/Caneles_stemilion.jpg/500px-Caneles_stemilion.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="Canelé" data-file-width="2250" data-file-height="1500" data-file-type="bitmap" height="167" width="250" class="mw-file-element mw-file-upright" style="--mw-file-upright: 1"/></a></span><div class="infobox-caption" style="padding-bottom:0.25em;border-bottom:1px solid var(--border-color-base, #a2a9b1);">Canelé</div></td></tr><tr class="note"><th scope="row" class="infobox-label" style="line-height:1.15em;
               padding-right:0.65em;">Alternative names</th><td class="infobox-data">Cannelé</td></tr><tr class="note"><th scope="row" class="infobox-label" style="line-height:1.15em;
               padding-right:0.65em;">Place of origin</th><td class="infobox-data country-name"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/France" title="France">France</a></td></tr><tr class="note"><th scope="row" class="infobox-label" style="line-height:1.15em;
               padding-right:0.65em;">Region or state</th><td class="infobox-data region"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Bordeaux" title="Bordeaux">Bordeaux</a></td></tr><tr class="note"><th scope="row" class="infobox-label" style="line-height:1.15em;
               padding-right:0.65em;">Created by</th><td class="infobox-data author">Couvent des Annonciades<sup about="#mwt6" class="mw-ref reference" id="cite_ref-A._Michel_1-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"A. Michel"},"body":{"id":"mw-reference-text-cite_note-A._Michel-1"}}'><a href="#cite_note-A._Michel-1" id="mwBQ"><span class="mw-reflink-text" id="mwBg"><span class="cite-bracket" id="mwBw">[</span>1<span class="cite-bracket" id="mwCA">]</span></span></a></sup></td></tr><tr><th scope="row" class="infobox-label" style="line-height:1.15em;
               padding-right:0.65em;">Serving temperature</th><td class="infobox-data">Warm</td></tr><tr><th scope="row" class="infobox-label" style="line-height:1.15em;
               padding-right:0.65em;">Main ingredients</th><td class="infobox-data ingredient"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Flour" title="Flour">flour</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Milk" title="Milk">milk</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Egg_yolk" title="Egg yolk" class="mw-redirect">egg yolk</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Butter" title="Butter">butter</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Vanilla" title="Vanilla">vanilla</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Rum" title="Rum">rum</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Sugar" title="Sugar">cane sugar</a></td></tr><tr><td colspan="2" class="infobox-below" style="border-top:1px solid var(--border-color-base, #a2a9b1);padding-top:0.25em;"><style data-mw-deduplicate="TemplateStyles:r1126788409" typeof="mw:Extension/templatestyles" about="#mwt9" data-mw='{"name":"templatestyles","attrs":{"src":"Plainlist/styles.css"},"body":{"extsrc":""}}'>.mw-parser-output .plainlist ol,.mw-parser-output .plainlist ul{line-height:inherit;list-style:none;margin:0;padding:0}.mw-parser-output .plainlist ol li,.mw-parser-output .plainlist ul li{margin-bottom:0}</style><div class="plainlist"><ul><li><span typeof="mw:Entity"> </span><span class="noviewer sister-project-logo" typeof="mw:File"><a href="https://en.wikipedia.org/wiki/File:Commons-logo.svg" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:Commons-logo.svg" src="//thumb.wikimedia.org/wikipedia/en/thumb/4/4a/Commons-logo.svg/20px-Commons-logo.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/en/thumb/4/4a/Commons-logo.svg/40px-Commons-logo.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="Wikimedia Commons logo" data-file-width="1024" data-file-height="1376" data-file-type="drawing" height="16" width="12" class="mw-file-element"/></a></span> <a rel="mw:WikiLink/Interwiki" href="https://commons.wikimedia.org/wiki/Category:Canelés%20bordelais" title="commons:Category:Canelés bordelais" class="extiw">Media<span typeof="mw:Entity">:</span> Canelé</a></li></ul></div></td></tr></tbody></table>
<figure class="mw-default-size" typeof="mw:File/Thumb" id="mwCQ"><a href="https://en.wikipedia.org/wiki/File:Cannele_interior_(12545)s.jpg" class="mw-file-description" id="mwCg"><img resource="https://en.wikipedia.org/wiki/File:Cannele_interior_(12545)s.jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/7/74/Cannele_interior_%2812545%29s.jpg/250px-Cannele_interior_%2812545%29s.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/7/74/Cannele_interior_%2812545%29s.jpg/500px-Cannele_interior_%2812545%29s.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="4127" data-file-height="2869" data-file-type="bitmap" height="174" width="250" class="mw-file-element" id="mwCw"/></a><figcaption id="mwDA">A canelé cut open, showing the contrast between exterior and interior. A large air pocket can be caused by several variables, such as excess egg white, unrested batter, or incorrect temperature.</figcaption></figure>
<p id="mwDQ">A <b id="mwDg">canelé</b> (<style data-mw-deduplicate="TemplateStyles:r1177148991" typeof="mw:Extension/templatestyles mw:Transclusion" about="#mwt10" id="mwDw" data-mw='{"name":"templatestyles","attrs":{"src":"Module:IPA/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"IPA","href":"./Template:IPA"},"params":{"1":{"wt":"fr"},"2":{"wt":"kan.le"},"3":{"wt":"lang"}},"i":0}}]}'>.mw-parser-output .IPA-label-small{font-size:85%}.mw-parser-output .references .IPA-label-small,.mw-parser-output .infobox .IPA-label-small,.mw-parser-output .navbox .IPA-label-small{font-size:100%}</style><span class="IPA-label IPA-label-small" about="#mwt10">French:</span><span about="#mwt10"> </span><span class="IPA nowrap" lang="fr-Latn-fonipa" about="#mwt10"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Help:IPA/French" title="Help:IPA/French"><span typeof="mw:Entity">[</span>kan.le<span typeof="mw:Entity">]</span></a></span><link rel="mw:PageProp/Category" href="./Category:Pages_with_French_IPA" about="#mwt10" id="mwEA"/>; <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Occitan_language" title="Occitan language" about="#mwt12" typeof="mw:Transclusion" id="mwEQ" data-mw='{"parts":[{"template":{"target":{"wt":"langx","href":"./Template:Langx"},"params":{"1":{"wt":"oc"},"2":{"wt":"Canelat"}},"i":0}}]}'>Occitan</a><span about="#mwt12">: </span><i lang="oc" about="#mwt12">Canelat</i><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Occitan_(post_1500)-language_text" about="#mwt12" id="mwEg"/>) is a small French <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Pâtisserie" title="Pâtisserie" id="mwEw">pâtisserie</a> flavoured with <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Rum" title="Rum" id="mwFA">rum</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Vanilla" title="Vanilla" id="mwFQ">vanilla</a>, having a soft and tender centre and a dark, thick, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Caramelization" title="Caramelization" id="mwFg">caramelized</a> crust. It takes the form of a small, <a rel="mw:WikiLink/Interwiki" href="https://en.wiktionary.org/wiki/striated" title="wikt:striated" class="extiw" id="mwFw">striated</a> cylinder up to five centimetres in height, with a depression at the top. A specialty of the region around <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Bordeaux" title="Bordeaux" id="mwGA">Bordeaux</a> in southwestern France, today it is widely available in pâtisseries in France and abroad.</p>

<meta property="mw:PageProp/toc" id="mwGQ" data-mw='{"autoGenerated":true}'/></section><section data-mw-section-id="1" id="mwGg" aria-labelledby="History"><div class="mw-heading mw-heading2"><h2 id="History">History</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Canel%C3%A9&amp;action=edit&amp;section=1" title="Edit section: History"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>

<p id="mwGw">The canelé is believed to originate from the <a rel="mw:WikiLink/Interwiki" href="https://fr.wikipedia.org/wiki/Couvent%20des%20Annonciades" title="fr:Couvent des Annonciades" class="extiw" id="mwHA">Couvent des Annonciades</a>, Bordeaux in either the 15th or the 18th century.<sup about="#mwt13" class="mw-ref reference" id="cite_ref-A._Michel_1-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"A. Michel"}}'><a href="#cite_note-A._Michel-1" id="mwHQ"><span class="mw-reflink-text" id="mwHg"><span class="cite-bracket" id="mwHw">[</span>1<span class="cite-bracket" id="mwIA">]</span></span></a></sup><sup about="#mwt16" class="mw-ref reference" id="cite_ref-Oxford_University_Press_2-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Oxford University Press"},"body":{"id":"mw-reference-text-cite_note-Oxford_University_Press-2"}}'><a href="#cite_note-Oxford_University_Press-2" id="mwIQ"><span class="mw-reflink-text" id="mwIg"><span class="cite-bracket" id="mwIw">[</span>2<span class="cite-bracket" id="mwJA">]</span></span></a></sup> The modern word "canelé" originates in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Gascon_language" title="Gascon language" class="mw-redirect" id="mwJQ">Gascon</a>, which was spoken in Bordeaux and a large area of southwestern France until the 19th century.<sup about="#mwt17" class="mw-ref reference" id="cite_ref-fute_3-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"fute"}}'><a href="#cite_note-fute-3" id="mwJg"><span class="mw-reflink-text" id="mwJw"><span class="cite-bracket" id="mwKA">[</span>3<span class="cite-bracket" id="mwKQ">]</span></span></a></sup></p>

<p id="mwKg">In <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Limoges" title="Limoges" id="mwKw">Limoges</a>, there was a food called <i id="mwLA">canole</i>, a bread made with flour and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Yolk" title="Yolk" id="mwLQ">egg yolks</a>, which may be the same item as that sold in Bordeaux since the 18th century under the name of <i id="mwLg">canaule</i>, also written <i id="mwLw">canaulé</i> or <i id="mwMA">canaulet</i>. Artisans known as  <i id="mwMQ">canauliers</i> who specialized in baking them registered a Corporation (or <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Guild" title="Guild" id="mwMg">guild</a>) with the Parliament of Bordeaux in 1663, which allowed only them to produce several specific foods: <i id="mwMw">Blessed bread</i>, <i id="mwNA">canaules</i>, and <i id="mwNQ">Retortillons</i>. Since they were not a part of the Pastry Corporation (Guild), which had a monopoly over baking with milk and sugar or <i id="mwNg">mixtionnée</i> dough, they were prohibited from using those ingredients. The <i id="mwNw">canauliers</i> disputed the Pastry Chefs' privileges and on 3 March 1755 the council of State in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Versailles_(commune)" title="Versailles (commune)" class="mw-redirect" id="mwOA">Versailles</a> ruled for  the <i id="mwOQ">canauliers</i> and ended the Pastry Chefs' monopoly. An edict of 1767 limited the number of authorized <i id="mwOg">canaulier</i> shops in a city to eight. It created very strict requirements for joining the profession. Nevertheless, in 1785 there were at least 39 <i id="mwOw">canaulier</i> shops in Bordeaux, at least ten of which were in the district (<i id="mwPA"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Faubourg" title="Faubourg" id="mwPQ">faubourg</a></i>) of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Saint-Seurin_(Bordeaux)?action=edit&amp;redlink=1" title="Saint-Seurin (Bordeaux) (page does not exist)" class="new" typeof="mw:LocalizedAttrs" id="mwPg" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["Saint-Seurin (Bordeaux)"]}}'>Saint-Seurin</a>. The <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/French_Revolution" title="French Revolution" id="mwPw">French Revolution</a> abolished all the Corporations, but later census rolls continue to show shops of Canauliers and bakers of "blessed bread".</p>

<p id="mwQA">In the first quarter of the 20th century the canelé reappeared, even if it is difficult to date exactly when. An unknown pastry chef re-popularised the antique recipe of <i id="mwQQ">canauliers</i>. He added rum and vanilla to his dough. It is likely that its current shape comes from the similarity (in French) of the word wave with the word "cannelure" (fluting, corrugation, striations).</p>

<p id="mwQg">The modern name "canelé" is of recent origin. The <i id="mwQw">Guide Gourmand de la France</i><sup about="#mwt20" class="mw-ref reference" id="cite_ref-4" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-4"}}'><a href="#cite_note-4" id="mwRA"><span class="mw-reflink-text" id="mwRQ"><span class="cite-bracket" id="mwRg">[</span>4<span class="cite-bracket" id="mwRw">]</span></span></a></sup> does not mention it. Only in 1985, after the pastry's popularity had begun to explode, was the Brotherhood of the Canelé of Bordeaux (Confrérie du Canelé de Bordeaux)<sup about="#mwt23" class="mw-ref reference" id="cite_ref-Bible_5-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Bible"},"body":{"id":"mw-reference-text-cite_note-Bible-5"}}'><a href="#cite_note-Bible-5" id="mwSA"><span class="mw-reflink-text" id="mwSQ"><span class="cite-bracket" id="mwSg">[</span>5<span class="cite-bracket" id="mwSw">]</span></span></a></sup> created and the second "n" of its name removed. The name <i id="mwTA">canelé</i> became a collective brand,<sup about="#mwt24" class="mw-ref reference" id="cite_ref-Oxford_University_Press_2-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Oxford University Press"}}'><a href="#cite_note-Oxford_University_Press-2" id="mwTQ"><span class="mw-reflink-text" id="mwTg"><span class="cite-bracket" id="mwTw">[</span>2<span class="cite-bracket" id="mwUA">]</span></span></a></sup><sup about="#mwt27" class="mw-ref reference" id="cite_ref-Hochbaum_6-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Hochbaum"},"body":{"id":"mw-reference-text-cite_note-Hochbaum-6"}}'><a href="#cite_note-Hochbaum-6" id="mwUQ"><span class="mw-reflink-text" id="mwUg"><span class="cite-bracket" id="mwUw">[</span>6<span class="cite-bracket" id="mwVA">]</span></span></a></sup> registered with the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/National_Industrial_Property_Institute_(France)" title="National Industrial Property Institute (France)" class="mw-redirect" id="mwVQ">National Institute of Industrial Property of France</a> by the Brotherhood. Ten years after the registration of the brand, there were at least 800 manufacturers in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Aquitaine" title="Aquitaine" id="mwVg">Aquitaine</a> and 600 in the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Gironde" title="Gironde" id="mwVw">Gironde</a>. In 1992, Gironde alone consumed an estimated 4.5 million canelés.</p>

</section><section data-mw-section-id="2" id="mwWA" aria-labelledby="Preparation_and_consumption"><div class="mw-heading mw-heading2"><h2 id="Preparation_and_consumption">Preparation and consumption</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Canel%C3%A9&amp;action=edit&amp;section=2" title="Edit section: Preparation and consumption"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwWQ">The <i id="mwWg">canelé</i> is traditionally baked in individual fluted <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Copper" title="Copper" id="mwWw">copper</a> molds, which are highly prized for their exceptional thermal conductivity. This property faclilitates an immediate thermal shock necessary for uniform surface <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Caramelization" title="Caramelization" id="mwXA">caramelization</a>, creating a crisp exterior while preserving a soft, custardy interior.<sup about="#mwt30" class="mw-ref reference" id="cite_ref-7" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-7"}}'><a href="#cite_note-7" id="mwXQ"><span class="mw-reflink-text" id="mwXg"><span class="cite-bracket" id="mwXw">[</span>7<span class="cite-bracket" id="mwYA">]</span></span></a></sup><sup about="#mwt31" class="mw-ref reference" id="cite_ref-Hochbaum_6-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Hochbaum"}}'><a href="#cite_note-Hochbaum-6" id="mwYQ"><span class="mw-reflink-text" id="mwYg"><span class="cite-bracket" id="mwYw">[</span>6<span class="cite-bracket" id="mwZA">]</span></span></a></sup> The molds are traditionally brushed with <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Beeswax" title="Beeswax" id="mwZQ">beeswax</a>.<sup about="#mwt34" class="mw-ref reference" id="cite_ref-8" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-8"}}'><a href="#cite_note-8" id="mwZg"><span class="mw-reflink-text" id="mwZw"><span class="cite-bracket" id="mwaA">[</span>8<span class="cite-bracket" id="mwaQ">]</span></span></a></sup> However, other coatings, such as a combination of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Beeswax" title="Beeswax" id="mwag">beeswax</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Butter" title="Butter" id="mwaw">butter</a>, came into use as the price of beeswax increased.<sup about="#mwt37" class="mw-ref reference" id="cite_ref-9" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-9"}}'><a href="#cite_note-9" id="mwbA"><span class="mw-reflink-text" id="mwbQ"><span class="cite-bracket" id="mwbg">[</span>9<span class="cite-bracket" id="mwbw">]</span></span></a></sup> Produced in numerous sizes, they can be consumed for breakfast, for snacks, and as a dessert depending in some measure on size.<sup about="#mwt40" class="mw-ref reference" id="cite_ref-fute_3-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"fute"},"body":{"id":"mw-reference-text-cite_note-fute-3"}}'><a href="#cite_note-fute-3" id="mwcA"><span class="mw-reflink-text" id="mwcQ"><span class="cite-bracket" id="mwcg">[</span>3<span class="cite-bracket" id="mwcw">]</span></span></a></sup> <i id="mwdA">Canelés</i> can be paired with red wine<sup about="#mwt41" class="mw-ref reference" id="cite_ref-Bible_5-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Bible"}}'><a href="#cite_note-Bible-5" id="mwdQ"><span class="mw-reflink-text" id="mwdg"><span class="cite-bracket" id="mwdw">[</span>5<span class="cite-bracket" id="mweA">]</span></span></a></sup> and many other beverages.</p>

<p id="mweQ">Traditionally, "canelés" or "cannelés of Bordeaux"<sup about="#mwt45" class="mw-ref reference" id="cite_ref-10" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-10"}}'><a href="#cite_note-10" id="mweg"><span class="mw-reflink-text" id="mwew"><span class="cite-bracket" id="mwfA">[</span>10<span class="cite-bracket" id="mwfQ">]</span></span></a></sup> are generally sold in bunches of 8 or 16. In Paris, most of the famous shops such as <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Ladurée" title="Ladurée" id="mwfg">Ladurée</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Pierre_Hermé" title="Pierre Hermé" id="mwfw">Pierre Hermé</a> still spell it as "cannelé of Bordeaux" with double 'n'.<link rel="mw:PageProp/Category" href="./Category:All_articles_with_unsourced_statements" about="#mwt42" typeof="mw:Transclusion" id="mwgA" data-mw='{"parts":[{"template":{"target":{"wt":"citation needed","href":"./Template:Citation_needed"},"params":{"date":{"wt":"October 2018"}},"i":0}}]}'/><link rel="mw:PageProp/Category" href="./Category:Articles_with_unsourced_statements_from_October_2018" about="#mwt42"/><sup class="noprint Inline-Template Template-Fact" style="white-space:nowrap;" about="#mwt42" id="mwgQ"><span typeof="mw:Entity">[</span><i><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wikipedia:Citation_needed" title="Wikipedia:Citation needed"><span title="This claim needs references to reliable sources. (October 2018)">citation needed</span></a></i><span typeof="mw:Entity">]</span></sup></p>

</section><section data-mw-section-id="3" id="mwgg" aria-labelledby="References"><div class="mw-heading mw-heading2"><h2 id="References">References</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Canel%C3%A9&amp;action=edit&amp;section=3" title="Edit section: References"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
