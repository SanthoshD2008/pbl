			<script language="Javascript">
	function pageselectCallback(page_index, jq){
		var blog_mea = jQuery('.global_blg .blogmea').length;
		var items_per_page = 4;

		if ($('#col_d').html() != null) var style=" style=\"width: 335px;\"";
		else var style="";
		
		var max_elem = Math.min((page_index+1) * items_per_page, jQuery('.global_blg .1_blg').length);
		var new_content = '';
		var depart=0;
		if (page_index > 0 && blog_mea == 1) depart = page_index*items_per_page+1;
		else depart = page_index*items_per_page;

		var is_gauche = true;
		var mea = false;
		
		for(var i=depart;i<max_elem;i++)
	    {
	      var new_content2 = '';
	      var new_content3 = '';
	      var blog_mea = jQuery('.global_blg .1_blg:eq('+i+')').hasClass('blogmea');
	      new_content2 = jQuery('.global_blg .1_blg:eq('+i+')').clone();

	      if (blog_mea) {
	    	  new_content3 = '<img src="/templates/common/images/actu_alaune.gif" style="float: left; position: absolute;" />'+'<div class="blogmea">' + new_content2.html() + '</div>';
	    	  mea = true;
	    	}
	      else {
	    	  new_content3 = '<div class="blog"'+style+'>' + new_content2.html() + '</div>';
	    	  is_gauche = true;
	    	}
	    	if (new_content2.html() != null) new_content += new_content3;
	    }
		if (mea) {
			var nbr = page_index*items_per_page+max_elem;
			new_content2 = jQuery('.global_blg .1_blg:eq('+nbr+')').clone();
			if (is_gauche) { new_content3 = '<div class="blog gauche"'+style+'>' + new_content2.html() + '</div>'; is_gauche = false; }
		  else { new_content3 = '<div class="blog"'+style+'>' + new_content2.html() + '</div>'; is_gauche = true; }
		  if (new_content2.html() != null) new_content += new_content3;
		}
	    $('#Searchresult').empty().append(new_content);
	    return false;
	}

	/* Initialisation function for pagination */
	function initPagination() {
	    // count entries inside the hidden content
	    var num_entries = jQuery('.global_blg .1_blg').length;
	    var blog_mea = jQuery('.global_blg .blogmea').length;
	    // Create content inside pagination element
		$("#Pagination2").pagination(num_entries-blog_mea, {
		    callback: pageselectCallback,
		    items_per_page:4,
		    prev_text: "<",
		    next_text: ">"
		});
	    $("#Pagination2").trigger('setPage', [0]);
	    if ( num_entries > 0 )
	    {
	    	$("#Pagination2").css({ display: 'block' });
	    }
	 }  
	// When document is ready, initialize pagination
	$(document).ready(function(){
	    initPagination();
	    if ($('.pagination').html() == '<span class="current prev">&lt;</span><span class="current">1</span><div class="cl"></div><span class="current prev2">&lt;</span><span class="current next">&gt;</span>') {
	    	$('.pagination').css('display', 'none');
	    }
	});
</script>

<h2 class="centre">Wine News in France</h2><br /><br />
<div class="two-third">	
	<div class="detailsBlg">	
	  <div class="blg">
	  	
	    <h3>Bordeaux Fete Le Vin – 20th Birthday.</h3>
<div class='blog_detail'>

<div align="center"><b>BORDEAUX FETE LE VIN - 20TH BIRTHDAY</b>
  <br />
</div>
<br /><img alt="" height="338" width="625" border="0" align="middle" style="width: 625px; height: 338px;" src="/medias/wtif1DoqjF7g/images/Popup/123/Fete-du-vin.jpg" />
<br />
<br />
<div align="center"><i><b>From June 14th to 18th 2018 will take place the now famous Bordeaux Wine Festival.
    
    
    
    
    </b></i>
  <br /><i><b>During the 4 days, 2 km wine route between the river and the 18th century buildings. Pavilions featuring 80 appellations from Bordeaux and the Aquitaine region, as well as the great brands of Bordeaux.</b></i>
  <br />
</div>
<br />
<br /><img alt="" height="183" width="125" border="0" align="right" style="width: 125px; height: 183px;" src="/medias/wtif1DoqjF7g/images/Popup/123/t%C3%A9l%C3%A9chargement.jpg" />Buy your “pass &amp; glass” a hop from one appellation to the other, meet the winemakers &amp; learn all you could ever imagine about the great wines of Bordeaux. 
<br />
<br />The festival will also host the arrival of the Tall Ships Regatta – these beautiful ships will leave Liverpool in the UK on May 25th for a triumphant arrival in Bordeaux during the wine festival. 
<br />The opportunity to discover some of the most beautiful sailing ships. An event not to be missed.
<br />
<br />
<br />Extend your stay in Bordeaux with a few days in the charming region of Cognac.
<br />Whether you want to explore the World Famous names in the world of Cognac or the more confidential producers, let us know &amp; we will take you to explore this unknown yet fascinating universe.
<br />
<br />Check out our article about Cognac published in <b>NEW YORK TIMES: </b><a rel="" class="none" href="http://nyti.ms/2h4zp7A">http://nyti.ms/2h4zp7A</a>
<br />
<br />
<br /></div><br /><br />
<link rel="image_src" href="/medias/wtif1DoqjF7g/images/Popup/123/Fete-du-vin.jpg" />
